# Copie para .env e substitua os dois valores por tokens independentes:
# openssl rand -hex 32
PORT=3000
WS_PORT=3001
HOST=127.0.0.1
ESP32_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO_DE_64_CARACTERES_HEXADECIMAIS
WS_PRODUCER_TOKEN=SUBSTITUA_POR_OUTRO_TOKEN_ALEATORIO_DE_64_CARACTERES_HEXADECIMAIS
WS_PRODUCER_ID=consumidor-http-01
WS_CONSUMER_URL=wss://localhost:3001/api/v1/publicacoes
WS_CA_CERT=.certs/local-cert.pem
TLS_KEY_PATH=.certs/local-key.pem
TLS_CERT_PATH=.certs/local-cert.pem
WS_PUBLISH_TIMEOUT_MS=60000
