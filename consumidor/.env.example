# A API atual usa ../.env (a raiz do repositório).
# Execute node scripts/setup.mjs na raiz. Veja ../.env.example.
# As variáveis abaixo servem SOMENTE para o consumidor WebSocket histórico,
# que não integra o fluxo novo do aplicativo móvel:
WS_PORT=3001
HOST=127.0.0.1
WS_PRODUCER_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO_DE_64_CARACTERES
WS_PRODUCER_ID=consumidor-http-01
TLS_KEY_PATH=
TLS_CERT_PATH=
