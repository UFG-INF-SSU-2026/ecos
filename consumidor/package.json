{
  "name": "ecos",
  "version": "1.0.0",
  "description": "**Cenário escolhido:** Lembrete Inteligente de Lanche para Estudo em Casa",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:ws": "node websocket-consumer/server.js",
    "start:local": "node --env-file=../.env server.js",
    "start:ws:local": "node --env-file=.env websocket-consumer/server.js",
    "test": "node --test \"test/*.test.js\"",
    "db:migrate": "node --env-file=../.env scripts/migrate.js",
    "db:provision": "node --env-file=../.env scripts/provision.js",
    "test:integration": "node --test test/integration.test.js",
    "simulate:device": "node --env-file=../.env scripts/simulate-device.js",
    "test:unit": "node --test test/auth.test.js test/domain.test.js test/app.test.js test/realtime.test.js test/contrato.test.js",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UFG-INF-SSU-2026/ecos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/UFG-INF-SSU-2026/ecos/issues"
  },
  "homepage": "https://github.com/UFG-INF-SSU-2026/ecos#readme",
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.22.0",
    "pg": "^8.16.3",
    "express-rate-limit": "^8.2.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
